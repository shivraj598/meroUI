{
  "name": "mero-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:components": "node scripts/generate-component-source.mjs",
    "dev": "npm run gen:components && next dev",
    "build": "npm run gen:components && next build",
    "start": "next start",
    "lint": "eslint",
    "cf-build": "npm run gen:components && opennextjs-cloudflare build && node scripts/copy-cache-assets.mjs",
    "cf-preview": "opennextjs-cloudflare preview",
    "cf-deploy": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "glimm": "^0.3.0",
    "gsap": "^3.15.0",
    "next": "16.2.12",
    "prismjs": "^1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.120.1"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  }
}
